# Copy to apps/web/.env and packages/database/.env (both gitignored),
# adjusting values as needed. Defaults here match docker-compose.yml.

# MSSQL connection (packages/database, apps/web)
DATABASE_URL="sqlserver://localhost:1433;database=bms;user=sa;password=BmsDashboard!2025;trustServerCertificate=true"

# Auth (apps/web) — added beyond the take-home spec to demonstrate
# session handling; a PIN is a demo scheme, not production auth.
# "1234" is the dev default (the login page shows a dev-only hint for it);
# the PIN is free-length, so for anything real generate a 32-char one:
#   openssl rand -hex 16
APP_PIN="1234"
AUTH_SECRET="generate with: openssl rand -base64 32"

# When set, all `now()`-based logic (time-range presets, occupancy
# staleness) uses this instant instead of the real wall clock — the seed
# data is a single day (2025-06-01, last reading 22:00/22:30) so real
# "today"/"last 7 days" filters are empty without it. Unset for real time
# (which honestly shows the empty/stale states — that's a feature, not a
# bug). See README's demo section for specific values to try.
DEMO_NOW=""
